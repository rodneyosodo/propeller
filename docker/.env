# Docker: Environment variables for the Propeller stack (Atom + FluxMQ)

# General
GRPC_MTLS=
PROP_RELEASE_TAG=latest
FLUXMQ_IMAGE_TAG=v1.0.0
ATOM_IMAGE_TAG=v1.0.0

## Atom (Identity & Authorization)
ATOM_HTTP_PORT=8080
ATOM_GRPC_PORT=8081
ATOM_LOG_LEVEL=info
ATOM_LOG_FORMAT=text
ATOM_PUBLIC_BASE_URL=http://atom:8080
ATOM_CORS_ALLOWED_ORIGINS=http://localhost:8080
ATOM_ADMIN_SECRET=12345678
ATOM_MIN_PASSWORD_CHARS=8
ATOM_ADMIN_ENTITY_ID=00000000-0000-0000-0000-000000000001
ATOM_SELF_REGISTRATION_ENABLED=true
ATOM_ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ATOM_METRICS_ENABLED=true
ATOM_KEY_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ATOM_KEY_ENCRYPTION_KEY_ID=local:v1
ATOM_JWT_AUDIENCE=propeller
ATOM_JWT_EXPIRY_SECS=3600
# Broker-auth MQTT clients retry while the stack boots, so the login throttle
# must tolerate brief bursts without locking a service out for the window.
ATOM_LOGIN_FAILURE_LIMIT=1000
ATOM_LOGIN_FAILURE_WINDOW_SECS=30

### Atom URL used by provisioning scripts
ATOM_URL=http://atom:8080
ATOM_SERVICE_TOKEN=

### Native FluxMQ broker auth (Atom implements FluxMQ's AuthService over gRPC)
### FluxMQ authenticates MQTT/HTTP/CoAP/AMQP clients directly against Atom, so
### no fluxmq-auth adapter service is required. Enabling it turns Atom's gRPC
### listener into mutual TLS (see certs below).
ATOM_BROKER_AUTH_ENABLED=true
# Propeller topics are m/<tenant>/c/<channel>/<subtopic>; the channel is
# addressed by UUID.
ATOM_BROKER_TOPIC_TEMPLATE=m/{tenant}/c/{resource}/{subtopic}
ATOM_BROKER_TOPIC_REF=uuid
# Propeller service entities authenticate with their shared key.
ATOM_BROKER_CREDENTIAL_KIND=shared_key
# gRPC mTLS material (generated by "make atom_grpc_certs" in docker/ssl).
# Paths are inside the Atom container (ssl/certs is mounted at /certs).
ATOM_GRPC_TLS_CERT_PATH=/certs/atom-grpc-server.crt
ATOM_GRPC_TLS_KEY_PATH=/certs/atom-grpc-server.key
ATOM_GRPC_TLS_CLIENT_CA_PATH=/certs/ca.crt

### Atom Database
ATOM_DB_USER=atom
ATOM_DB_PASS=atom
ATOM_DB_NAME=atom

## FluxMQ
MG_FLUXMQ_API_PORT=9081
MG_COAP_PORT=5683

## NginX
MG_NGINX_HTTP_PORT=80
MG_NGINX_SSL_PORT=443
MG_NGINX_MQTT_PORT=1883
MG_NGINX_MQTT_V5_PORT=1884
MG_NGINX_MQTTS_PORT=8883
MG_NGINX_AMQP_PORT=5682
MG_NGINX_SERVER_NAME=

## Jaeger (Distributed Tracing)
MG_JAEGER_COLLECTOR_OTLP_ENABLED=true
MG_JAEGER_FRONTEND=16686
MG_JAEGER_OLTP_HTTP=4318
MG_JAEGER_URL=http://jaeger:4318/v1/traces
MG_JAEGER_TRACE_RATIO=1.0
MG_JAEGER_MEMORY_MAX_TRACES=5000

## Manager
MANAGER_LOG_LEVEL=info
MANAGER_INSTANCE_ID=""
MANAGER_MQTT_ADDRESS="tcp://nginx:${MG_NGINX_MQTT_PORT}"
MANAGER_MQTT_QOS=2
MANAGER_MQTT_TIMEOUT=30s
# MQTT over TLS — use ssl:// scheme and uncomment cert paths:
# MANAGER_MQTT_ADDRESS="ssl://nginx:${MG_NGINX_MQTTS_PORT}"
# MANAGER_MQTT_TLS_CA_CERT=/etc/propeller/tls/ca.crt
# MANAGER_MQTT_TLS_CLIENT_CERT=/etc/propeller/tls/client.crt
# MANAGER_MQTT_TLS_CLIENT_KEY=/etc/propeller/tls/client.key
# MANAGER_MQTT_TLS_INSECURE_SKIP_VERIFY=false
# These are provisioned by setup-propeller.sh or set manually.
# In Atom: entity of kind "service", profile "Service Account".
MANAGER_TENANT_ID=
MANAGER_CHANNEL_ID=
MANAGER_ENTITY_ID=
MANAGER_API_KEY=
MANAGER_HTTP_HOST=manager
MANAGER_HTTP_PORT=7070
MANAGER_HTTP_SERVER_CERT=""
MANAGER_HTTP_SERVER_KEY=""
MANAGER_OTEL_URL=${MG_JAEGER_URL}
MANAGER_TRACE_RATIO=${MG_JAEGER_TRACE_RATIO}

## Proplet
PROPLET_LOG_LEVEL=info
PROPLET_INSTANCE_ID=""
PROPLET_MQTT_ADDRESS="tcp://nginx:${MG_NGINX_MQTT_PORT}"
PROPLET_MQTT_QOS=2
PROPLET_MQTT_TIMEOUT=30s
# MQTT over TLS — use ssl:// scheme and uncomment cert paths:
# PROPLET_MQTT_ADDRESS="ssl://nginx:${MG_NGINX_MQTTS_PORT}"
# PROPLET_MQTT_TLS_CA_CERT=/etc/propeller/tls/ca.crt
# PROPLET_MQTT_TLS_CLIENT_CERT=/etc/propeller/tls/client.crt
# PROPLET_MQTT_TLS_CLIENT_KEY=/etc/propeller/tls/client.key
# PROPLET_MQTT_TLS_INSECURE_SKIP_VERIFY=false
PROPLET_LIVELINESS_INTERVAL="10s"
# These are provisioned by setup-propeller.sh or set manually.
# In Atom: entity of kind "service", profile "Service Account".
PROPLET_TENANT_ID=
PROPLET_CHANNEL_ID=
PROPLET_ENTITY_ID=
PROPLET_API_KEY=
PROPLET_EXTERNAL_WASM_RUNTIME="wasmtime"
PROPLET_MANAGER_K8S_NAMESPACE="default"
PROPLET_HAL_ENABLED="false" # Disabled currently, to enable it you need to set `PROPLET_EXTERNAL_WASM_RUNTIME` to `""` so that it can use default wasmtime.
PROPLET_HTTP_ENABLED="false"
# HTTP over TLS — uncomment to trust custom CA certs for outgoing HTTPS requests:
# PROPLET_HTTP_TLS_CA_CERT=/etc/propeller/tls/http-ca.crt
# PROPLET_HTTP_TLS_INSECURE_SKIP_VERIFY=false
PROPLET_METRICS_PORT=9092
PROPLET_METRICS_ENABLED=true
PROPLET_OTEL_URL=${MG_JAEGER_URL}
PROPLET_TRACE_RATIO=${MG_JAEGER_TRACE_RATIO}
PROPLET_CONFIG_FILE="config.toml"
PROPLET_CONFIG_SECTION="proplet"
PROPLET_IMAGE="ghcr.io/absmach/propeller/proplet"
PROPLET_IMAGE_TAG="latest"

## Proxy
PROXY_LOG_LEVEL=info
PROXY_INSTANCE_ID=""
PROXY_MQTT_ADDRESS="tcp://nginx:${MG_NGINX_MQTT_PORT}"
PROXY_MQTT_QOS=2
PROXY_MQTT_TIMEOUT=30s
# MQTT over TLS — use ssl:// scheme and uncomment cert paths:
# PROXY_MQTT_ADDRESS="ssl://nginx:${MG_NGINX_MQTTS_PORT}"
# PROXY_MQTT_TLS_CA_CERT=/etc/propeller/tls/ca.crt
# PROXY_MQTT_TLS_CLIENT_CERT=/etc/propeller/tls/client.crt
# PROXY_MQTT_TLS_CLIENT_KEY=/etc/propeller/tls/client.key
# PROXY_MQTT_TLS_INSECURE_SKIP_VERIFY=false
# These are provisioned by setup-propeller.sh or set manually.
# In Atom: entity of kind "service", profile "Service Account".
PROXY_TENANT_ID=
PROXY_CHANNEL_ID=
PROXY_ENTITY_ID=
PROXY_API_KEY=
PROXY_HTTP_PORT=9191
PROXY_OTEL_URL=${MG_JAEGER_URL}
PROXY_TRACE_RATIO=${MG_JAEGER_TRACE_RATIO}
PROXY_CHUNK_SIZE=512000
PROXY_AUTHENTICATE=false
PROXY_REGISTRY_TOKEN=""
PROXY_REGISTRY_USERNAME=""
PROXY_REGISTRY_PASSWORD=""
PROXY_REGISTRY_URL="docker.io"

## Federated Learning (optional)
### Proplet-2 Entity Credentials
PROPLET_2_ENTITY_ID=
PROPLET_2_API_KEY=

### Proplet-3 Entity Credentials
PROPLET_3_ENTITY_ID=
PROPLET_3_API_KEY=

### FL Coordinator Entity Credentials
COORDINATOR_ENTITY_ID=
COORDINATOR_API_KEY=

### FML Service URLs
### These can be overridden for different deployment environments (K8s, bare metal, etc.)
MANAGER_COORDINATOR_URL=http://coordinator-http:8080
MODEL_REGISTRY_URL=http://model-registry:8081
DATA_STORE_URL=http://local-data-store:8083

### Job execution mode: configurable, sequential, or parallel
JOB_EXECUTION_MODE=configurable
